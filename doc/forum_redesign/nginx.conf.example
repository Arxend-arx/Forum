# ============================================================
# Academy 前后端分离部署示例（Nginx 反代）
# ------------------------------------------------------------
# 前端构建:  cd forum_project/frontend && npm run build   # 产物 -> frontend/dist
# 将 dist 上传至服务器 /var/www/academy/dist
# 后端:      运行 forum_project/app.py（Flask :5000，已含 dist 托管时可省略本文件，
#            直接 python -B app.py 单端口访问）
# 该配置用于"前端静态托管 + /api 反代"的标准前后端分离部署。
# ============================================================

server {
    listen 80;
    server_name academy.example.com;   # 替换为你的域名/IP

    # 前端构建产物（SPA）
    root /var/www/academy/dist;
    index index.html;

    # 后端 REST API 反代
    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 上传文件（图片/视频，由后端提供）
    location /uploads/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
    }

    # SPA 路由 fallback（前端路由如 /post/1 刷新时不 404）
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 静态资源缓存
    location ~* \.(js|css|png|jpg|jpeg|gif|svg|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
    }
}
